{
  "name": "inside-access",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/database.ts setup",
    "db:import": "node --env-file-if-exists=.env --import tsx scripts/database.ts import",
    "db:export": "node --env-file-if-exists=.env --import tsx scripts/database.ts export",
    "db:backup": "node --env-file-if-exists=.env --import tsx scripts/database.ts backup",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "discover": "node --env-file-if-exists=.env --import tsx scripts/discover.ts",
    "verify:data": "node --env-file-if-exists=.env --import tsx scripts/verify-data.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/dev.ts --production",
    "db:restore": "node --env-file-if-exists=.env --import tsx scripts/restore-local.ts",
    "discover:proof": "node --env-file-if-exists=.env --import tsx scripts/discovery-proof.ts",
    "discover:validate": "node --env-file-if-exists=.env --import tsx scripts/validate-discovery.ts",
    "images:enrich": "node --env-file-if-exists=.env --import tsx scripts/enrich-images.ts",
    "images:validate": "node --env-file-if-exists=.env --import tsx scripts/validate-images.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@supabase/supabase-js": "2.118.0",
    "express": "5.3.0",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "jsdom": "30.1.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
