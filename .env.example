# Local: uses a disk-backed embedded PostgreSQL database. No cloud account needed.
# Credentials are created interactively with npm run admin:create; no default login.
VITE_DATA_MODE=local
# Hosted build: change mode to supabase and supply these PUBLIC values.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Server/CLI only; never prefix these with VITE_.
# DATABASE_URL=postgresql://...
# LOCAL_DB_PATH=.local/pgdata
# DISCOVERY_ENABLED=false  # Hosted CLI opt-in only; local scheduler uses reviewed source settings.
